# Copy this file to ".env" and fill in real values. Never commit ".env".

PORT=5000
NODE_ENV=development

# MongoDB (bids/sell/approve use transactions -> use MongoDB Atlas or a local replica set)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/auctionpro

# Long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Frontend address(es), comma separated, NO trailing slash. Must match exactly (CORS + reset-password link).
# The FIRST address is the one used in reset-password e-mails. It must be your FRONTEND, not the backend URL.
# Local: http://localhost:5173    Deployed: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Cloudinary (team logos, player photos, auction banners)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- E-mail (forgot-password link, also used for team owners created by the admin) ----
# Test your settings any time with:  node scripts/testEmail.js you@example.com
#
# OPTION A - SMTP (Gmail etc.). Works on your own computer and on paid hosting.
# NOTE: Render's FREE web services block SMTP ports 25/465/587, so use option B there.
# Gmail needs an App Password (2-Step Verification must be on), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# OPTION B - Brevo HTTPS API (works on Render free plan). If BREVO_API_KEY is set it is used instead of SMTP.
# Create a free Brevo account, verify your sender address (Senders), then create an API key.
# BREVO_API_KEY=

# Sender shown in the e-mail. Optional for SMTP (defaults to SMTP_USER).
# Required for Brevo, and it must be a sender verified in Brevo.
MAIL_FROM="AuctionPro <no-reply@example.com>"
