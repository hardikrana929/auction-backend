# Copy this file to ".env" and fill in real values. Never commit ".env".

PORT=5000
NODE_ENV=development

# MongoDB (bids/sell/approve use transactions -> use MongoDB Atlas or a local replica set)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/auctionpro

# Long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Frontend address(es), comma separated, NO trailing slash. Must match exactly (CORS + reset-password link).
# The FIRST address is the one used in reset-password e-mails. It must be your FRONTEND, not the backend URL.
# Local: http://localhost:5173    Deployed: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Cloudinary (team logos, player photos, auction banners)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- E-mail: Resend is preferred for Render Free (HTTPS API on port 443) ----
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Use an address on a domain verified in Resend, e.g. AuctionPro <no-reply@yourdomain.com>
MAIL_FROM="AuctionPro <no-reply@yourdomain.com>"

# Optional compatibility providers. Provider priority: Resend > Brevo > SMTP.
# BREVO_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Gmail requires a Google App Password, not your normal Gmail password.
# Test e-mail: node scripts/testEmail.js recipient@example.com
